{
  "name": "gobang-v3",
  "version": "3.0.0",
  "description": "AI 五子棋桌面版（React + Electron + Rapfi 引擎）",
  "author": "AI 五子棋",
  "private": true,
  "homepage": "./",
  "main": "electron-main.js",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "antd": "^5.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.2",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "eject": "react-app-rewired eject",
    "dist": "npm run build && npx electron-builder --win portable"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "react-app-rewired": "^2.2.1"
  },
  "build": {
    "extends": null,
    "appId": "com.gobang.app",
    "productName": "AI五子棋",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "!build/**/*.map",
      "electron-main.js",
      "electron-main/**/*",
      "src/preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release/rapfi",
        "to": "rapfi",
        "filter": [
          "**/*",
          "!**/*.7z",
          "!linux/**"
        ]
      }
    ],
    "asarUnpack": [
      "resources/rapfi/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico",
      "artifactName": "AI五子棋.exe",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "AI五子棋.exe"
    },
    "compression": "maximum"
  }
}
